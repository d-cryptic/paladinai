{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.7/.schema/devbox.schema.json",
  "packages": [
    "go@1.23",
    "buf@1.34.0",
    "protoc-gen-go@1.34.2",
    "protoc-gen-go-grpc@1.5.1",
    "golangci-lint@1.60.3",
    "mockgen@0.5.0",
    "migrate@4.18.1",
    "air@1.61.5",
    "just@1.36.0",
    "jq@1.7.1",
    "mkcert@1.4.4"
  ],
  "shell": {
    "init_hook": [
      "echo '🛡️  PaladinAI v2 dev environment ready'",
      "echo '  make help     — list all targets'",
      "echo '  make up       — start infrastructure'",
      "echo '  make dev      — start all services (hot-reload)'"
    ],
    "scripts": {
      "test": ["make test"],
      "lint": ["make lint"],
      "build": ["make build"]
    }
  }
}
