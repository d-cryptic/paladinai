# Load .env file if present (never commit .env — only .env.example)
dotenv_if_exists .env

# Go workspace
export GOFLAGS="-mod=mod"
export CGO_ENABLED=0

# Dev defaults (overridden by .env in real environments)
export ENV="${ENV:-development}"
export LOG_LEVEL="${LOG_LEVEL:-debug}"

# NATS
export NATS_URL="${NATS_URL:-nats://localhost:4222}"

# PostgreSQL
export DATABASE_URL="${DATABASE_URL:-postgres://paladin:paladin@localhost:5432/paladin?sslmode=disable}"

# Valkey (Redis-compatible)
export VALKEY_URL="${VALKEY_URL:-redis://localhost:6379}"

# Qdrant
export QDRANT_URL="${QDRANT_URL:-http://localhost:6333}"
export QDRANT_API_KEY="${QDRANT_API_KEY:-}"

# FalkorDB
export FALKORDB_URL="${FALKORDB_URL:-redis://localhost:6380}"

# LLM Gateway
export LLM_GATEWAY_URL="${LLM_GATEWAY_URL:-http://localhost:8080}"
export OPENROUTER_API_KEY="${OPENROUTER_API_KEY:-}"

# Service ports
export PALADIN_INGEST_PORT="${PALADIN_INGEST_PORT:-9001}"
export PALADIN_EDGE_PORT="${PALADIN_EDGE_PORT:-9002}"
export PALADIN_AGENT_PORT="${PALADIN_AGENT_PORT:-9003}"
export PALADIN_HUB_PORT="${PALADIN_HUB_PORT:-9004}"
export PALADIN_MEMORY_PORT="${PALADIN_MEMORY_PORT:-9005}"
export PALADIN_AUTH_PORT="${PALADIN_AUTH_PORT:-9006}"
export PALADIN_WS_PORT="${PALADIN_WS_PORT:-9007}"
export PALADIN_ORCHESTRATOR_PORT="${PALADIN_ORCHESTRATOR_PORT:-9008}"

# Hatchet
export HATCHET_CLIENT_TOKEN="${HATCHET_CLIENT_TOKEN:-}"
export HATCHET_CLIENT_TLS_STRATEGY="${HATCHET_CLIENT_TLS_STRATEGY:-none}"

# Vault
export VAULT_ADDR="${VAULT_ADDR:-http://localhost:8200}"
export VAULT_TOKEN="${VAULT_TOKEN:-dev-root-token}"

# Telemetry
export OTEL_EXPORTER_OTLP_ENDPOINT="${OTEL_EXPORTER_OTLP_ENDPOINT:-http://localhost:4317}"
export OTEL_SERVICE_VERSION="${OTEL_SERVICE_VERSION:-dev}"

# use devbox
watch_file devbox.json
eval "$(devbox generate direnv --print-envrc 2>/dev/null || true)"
