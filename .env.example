# Copy this file to .env and fill in real values.
# .env is gitignored. NEVER commit real secrets.

ENV=development
LOG_LEVEL=debug

# LLM routing
OPENROUTER_API_KEY=sk-or-v1-...

# Infrastructure (default values match docker-compose.yml)
NATS_URL=nats://localhost:4222
DATABASE_URL=postgres://paladin:paladin@localhost:5432/paladin?sslmode=disable
VALKEY_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
FALKORDB_URL=redis://localhost:6380

# LLM gateway (paladin-gateway runs on 8080 locally)
LLM_GATEWAY_URL=http://localhost:8080

# Hatchet (generated on first `make hatchet-token`)
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_TLS_STRATEGY=none

# HashiCorp Vault (dev mode — no auth needed locally)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token

# OTel collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_VERSION=dev

# Service ports (defaults match docker-compose)
PALADIN_INGEST_PORT=9001
PALADIN_EDGE_PORT=9002
PALADIN_AGENT_PORT=9003
PALADIN_HUB_PORT=9004
PALADIN_MEMORY_PORT=9005
PALADIN_AUTH_PORT=9006
PALADIN_WS_PORT=9007
PALADIN_ORCHESTRATOR_PORT=9008
