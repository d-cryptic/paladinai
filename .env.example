# PaladinAI v2 — environment variable template
# Copy this file to .env and fill in real values: cp .env.example .env
# .env is gitignored. NEVER commit real secrets.
#
# Quick start:
#   1. cp .env.example .env
#   2. Fill in OPENROUTER_API_KEY (or leave blank for mock LLM)
#   3. make up          # starts NATS, Postgres, Valkey, Qdrant
#   4. make up-services # starts all PaladinAI Go services
#   5. paladin doctor   # verify connectivity

ENV=development
LOG_LEVEL=debug

# Postgres credentials (used by docker-compose interpolation)
PG_PASSWORD=paladin

# ─── Auth ────────────────────────────────────────────────────────────────────
# Minimum 32 chars for HS256. Generate with: openssl rand -hex 32
JWT_SECRET=paladin-dev-jwt-secret-min-32-chars!!
# Admin secret for tenant management (never exposed to end users)
ADMIN_SECRET=paladin-admin-secret

# ─── CLI / dev tokens ─────────────────────────────────────────────────────────
PALADIN_TOKEN=dev-token-change-me
PALADIN_TENANT=local-dev

# ─── LLM routing ──────────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai — required for live agent calls.
# Leave blank to use the local mock LLM (make up with --profile mock).
OPENROUTER_API_KEY=
# Model tier overrides (defaults shown)
LLM_TIER_A=qwen/qwen3-1.7b
LLM_TIER_B=qwen/qwen3-8b
LLM_TIER_C=deepseek/deepseek-v3
# Embedding model for RAG (requires OPENROUTER_API_KEY)
EMBED_MODEL=BAAI/bge-m3

# ─── Infrastructure (default values match docker-compose.yml) ─────────────────
NATS_URL=nats://localhost:4222
DATABASE_URL=postgres://paladin:paladin@localhost:5432/paladin?sslmode=disable
VALKEY_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
FALKORDB_URL=redis://localhost:6380

# ─── LLM gateway ──────────────────────────────────────────────────────────────
# For real calls: https://openrouter.ai/api/v1
# For local mock: http://localhost:1080/api/v1  (make up --profile mock)
LLM_GATEWAY_URL=https://openrouter.ai/api/v1

# ─── Service-to-service URLs (for paladin-edge proxy routing) ─────────────────
INGEST_URL=http://localhost:9001
AUTH_URL=http://localhost:9003
HUB_URL=http://localhost:8082
AGENT_URL=http://localhost:9004

# ─── Hatchet (generated on first `make hatchet-token`) ───────────────────────
HATCHET_URL=http://localhost:7077
HATCHET_API_KEY=
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_TLS_STRATEGY=none

# ─── HashiCorp Vault (dev mode — no auth needed locally) ──────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_VERSION=dev

# ─── Service ports (defaults match docker-compose) ────────────────────────────
PALADIN_INGEST_PORT=9001
PALADIN_EDGE_PORT=9002
PALADIN_AUTH_PORT=9003
PALADIN_HUB_PORT=8082
PALADIN_MEMORY_GRPC_ADDR=:9005
PALADIN_WS_PORT=9007
PALADIN_ORCHESTRATOR_PORT=9008
PALADIN_AGENT_PORT=9004

# ─── Orchestrator ─────────────────────────────────────────────────────────────
ORCHESTRATOR_WORKERS=4
ORCHESTRATOR_CONSUMER_NAME=paladin-orchestrator

# ─── Memory service ───────────────────────────────────────────────────────────
MEMORY_WORKING_TTL=1800   # 30 min in seconds
